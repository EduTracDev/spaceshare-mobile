import prisma from "../";

/**
 * Generate a unique transaction number for a transaction of the given type.
 * @param type The type of transaction (PAYMENT, PAYOUT, REFUND).
 * @returns A unique transaction number.
 */


export async function generateTransactionNumber(
  type: 'PAYMENT' | 'PAYOUT' | 'REFUND'
): Promise<string> {
  const PREFIX = { PAYMENT: 'PY', PAYOUT: 'PO', REFUND: 'RF' }[type];
  // Same upsert pattern as bookingNumber/disputeNumber — key = 'TRANSACTION'
  const seq = await (prisma as any).$transaction([
    (prisma as any).numberSequence.upsert({
      where: { key: 'TRANSACTION' },
      create: { key: 'TRANSACTION', nextValue: 2 },
      update: { nextValue: { increment: 1 } },
    }),
  ]);
  const raw = (seq[0].nextValue - 1).toString().padStart(5, '0');
  return `${PREFIX}-${raw}`;
}
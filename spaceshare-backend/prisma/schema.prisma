generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  password         String
  role             Role              @default(GUEST)
  isVerified       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  avatarUrl        String?
  firstName        String?
  lastName         String?
  phone            String?
  isFirstLogin     Boolean           @default(true)
  verificationCode VerificationCode?
  listings         Listing[]
  bookings         Booking[]
}

model VerificationCode {
  id        String   @id @default(cuid())
  code      String
  expiresAt DateTime
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  GUEST
  HOST
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  APPROVED
  DECLINED
  PAID
  COMPLETED
  CANCELLED
}

model Listing {
  id                String        @id @default(cuid())
  hostId            String
  host              User          @relation(fields: [hostId], references: [id], onDelete: Cascade)

  spaceName         String
  spaceCategory     String
  addressLine       String
  area              String
  description       String

  photos            String[]
  amenities         String[]

  spaceCapacity     Int
  spacePrice        Int

  addOns            Json?

  hostRules         String
  parkingInstruction String?

  startTime         String
  endTime           String
  unavailableDates  String[]

  status            ListingStatus @default(PENDING)
  rejectionReason   String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  bookings          Booking[]
}

model Booking {
  id              String        @id @default(cuid())
  listingId       String
  listing         Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  guestId         String
  guest           User          @relation(fields: [guestId], references: [id], onDelete: Cascade)

  spaceName       String
  spaceLocation   String
  spacePrice      Int

  startDate       String
  endDate         String
  startTime       String
  endTime         String
  guests          Int

  addOnsBreakdown Json?
  cautionFee      Int           @default(0)
  serviceFee      Int           @default(0)
  totalPrice      Int

  status          BookingStatus @default(PENDING)
  paymentRef      String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  password         String?
  role             Role              @default(GUEST)
  isVerified       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  avatarUrl        String?
  firstName        String?
  lastName         String?
  phone            String?
  isFirstLogin        Boolean           @default(true)
  authProvider        AuthProvider      @default(LOCAL)
  googleId            String?           @unique
  appleId             String?           @unique
  emailNotifications  Boolean           @default(true)
  smsNotifications    Boolean           @default(true)
  pushNotifications   Boolean           @default(true)
  pushToken           String?
  verificationCode    VerificationCode?
  listings         Listing[]
  bookings         Booking[]
  notifications    Notification[]

  status           UserStatus           @default(PENDING)
  invitedAt        DateTime?
  invitedBy        String?
  invitedByUser    User?      @relation("InvitedBy", fields: [invitedBy], references: [id])
  lastLoginAt      DateTime?
  invited          User[]     @relation("InvitedBy")
  passwordHistories  PasswordHistory[]
  adminInvitations AdminInvitation[] @relation("AdminInvitations")

  reviewsWritten    Review[] @relation("ReviewAuthor")
  reviewsReceived   Review[] @relation("ReviewHost")
  reviewsReported   Review[] @relation("ReviewReporter")
  auditLogsAsActor  AuditLog[] @relation("AuditActor")
  auditLogsAsTarget AuditLog[] @relation("AuditTarget")
  disputesRaised    Dispute[] @relation("DisputesRaised")
  disputesResolved  Dispute[] @relation("DisputesResolved")
  transactionsReceived Transaction[] @relation("TransactionRecipient")

  cancelledBookings Booking[] @relation("BookingCancelledBy")
  bankAccount       BankAccount?
}

model VerificationCode {
  id        String   @id @default(cuid())
  code      String
  expiresAt DateTime
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum Role {
  GUEST
  HOST
  ADMIN
  SUPER_ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  APPROVED
  DECLINED
  PAID
  COMPLETED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum TransactionType {
  PAYMENT
  REFUND
  PAYOUT
}

enum TransactionStatus {
  PENDING
  SUCCESSFUL
  FAILED
}



enum NotificationType {
  BOOKING_REQUEST_SENT
  BOOKING_APPROVED
  BOOKING_DECLINED
  BOOKING_CANCELLED
  PAYMENT_SUCCESSFUL
  PAYMENT_FAILED
  REVIEW_REMINDER
  DISPUTE_SUBMITTED
  REFUND_PROCESSED
  NEW_BOOKING_REQUEST
  LISTING_APPROVED
  LISTING_REJECTED
  REVIEW_RECEIVED
  PAYOUT_SENT

  LISTING_SUBMITTED
  BOOKING_REQUIRES_ATTENTION
  NEW_USER_REGISTERED
  REVIEW_REPORTED
  PAYOUT_READY
  ADMIN_ACTIVITY
  TRANSACTION_FAILED
  DISPUTE_RAISED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  bookingId String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  referenceId  String?
}

model Listing {
  id                String        @id @default(cuid())
  hostId            String
  host              User          @relation(fields: [hostId], references: [id], onDelete: Cascade)

  spaceName         String
  spaceCategory     String
  addressLine       String
  area              String
  description       String

  photos            String[]
  amenities         String[]

  spaceCapacity     Int
  spacePrice        Int

  addOns            Json?

  hostRules         String
  parkingInstruction String?

  startTime         String
  endTime           String
  unavailableDates  String[]

  status            ListingStatus @default(PENDING)
  rejectionReason   String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  avgRating         Float         @default(0)
  reviewCount       Int           @default(0)

  bookings          Booking[]  
  reviews           Review[]
}

model Booking {
  id              String        @id @default(cuid())
  listingId       String
  listing         Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  guestId         String
  guest           User          @relation(fields: [guestId], references: [id], onDelete: Cascade)

  spaceName       String
  spaceLocation   String
  spacePrice      Int

  startDate       String
  endDate         String
  startTime       String
  endTime         String
  guests          Int

  addOnsBreakdown Json?
  cautionFee      Int           @default(0)
  serviceFee      Int           @default(0)
  totalPrice      Int

  status          BookingStatus @default(PENDING)
  declineReason   String?
  cancelReason    String?
  cancelledAt     DateTime?
  cancelledById   String?
  cancelledBy     User?         @relation("BookingCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledByRole CancelledByRole?   // HOST | GUEST
  paymentRef      String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  review Review?
  disputes        Dispute[]
  transactions    Transaction[]

  bookingNumber     String    @unique   //e.g. BK_245262
}

enum CancelledByRole {
  HOST
  GUEST
  ADMIN
}

model Transaction {
  id              String             @id @default(cuid())
  bookingId       String
  booking         Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type            TransactionType
  status          TransactionStatus  @default(PENDING)

  amount          Int
  // Only populated on PAYOUT transactions — the commission rate applied at the time,
  // stored here so later changes to PlatformSettings never retroactively alter history
  commissionRate  Int?
  commissionAmount Int?

  providerRef     String?
  providerMeta    Json?

  recipientId     String?
  recipient       User?              @relation("TransactionRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  purpose         TransactionPurpose?
  transactionNumber String @unique
  paidAt          DateTime?     //timestamp admin marked payment as done

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([bookingId])
  @@index([type, status])
  @@index([recipientId])
}

enum TransactionPurpose {
  HOST_PAYOUT
  CAUTION_FEE_PAYOUT
}

model Dispute {
  id             String        @id @default(cuid())
  bookingId      String
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedById     String
  raisedBy       User          @relation("DisputesRaised", fields: [raisedById], references: [id], onDelete: Cascade)

  issueDetail    String
  evidenceUrl    String?

  status         DisputeStatus @default(OPEN)
  resolutionNote String?
  resolvedById   String?
  resolvedBy     User?         @relation("DisputesResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  disputeNumber     String    @unique         //e.g. DP-2063736

  @@index([bookingId])
  @@index([raisedById])
  @@index([status, createdAt])
}

model NumberSequence {
  key       String   @id     // "BOOKING", "DISPUTE"
  nextValue Int      @default(1)
}

model PasswordHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash      String
  usedAt    DateTime @default(now())

  @@index([userId])
}


model AuditLog {
  id          String      @id @default(cuid())
  action      LogActivity
  description String
  createdAt   DateTime    @default(now())

  actorId      String
  actor        User        @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetUserId String?
  targetUser   User?       @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
}

enum LogActivity {
  INVITED_ADMIN
  UPDATED_COMMISSION
  ADMIN_SUSPENDED_USER
  ADMIN_RESTORED_USER
  ADMIN_LOGIN
  ADMIN_LOGOUT
  RESENT_ADMIN_INVITATION
  REVOKED_ADMIN_INVITATION
  SUPERADMIN_SUSPENDED_ADMIN
  RESTORED_ADMIN_ACCESS
  APPROVED_SPACE_LISTING
  REJECTED_SPACE_LISTING
  SUSPENDED_SPACE_LISTING
  REACTIVATED_SPACE_LISTING
  REMOVED_REVIEW
  RESTORED_REVIEW
  VERIFIED_PAYMENT
  VERIFIED_DISPUTE_RESOLUTION 
}


model AdminInvitation {
  id          String   @id  @default(cuid())
  email       String
  firstName   String
  lastName    String
  tokenHash   String   @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  invitedBy   User     @relation("AdminInvitations", fields: [invitedById], references: [id])

  @@index([email])
  @@index([invitedById])
}

model PlatformSettings{
  id          String   @id  @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt       DateTime      @updatedAt
  
  hostCommission  Int   @default(15)
  guestProcessingFee Int    @default(5)
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)


  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  authorId   String   // guestId from booking (review author = booking guest)
  author     User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  hostId     String   // hostId from listing (used for REVIEW_RECEIVED notification target)
  host       User     @relation("ReviewHost", fields: [hostId], references: [id], onDelete: Cascade)


  rating     Int      // 1..5 stars. Add CHECK constraint or validate service-layer: BETWEEN 1 AND 5.
  comment    String   // From ReviewSection L10 `comment: string` + booking-details reviewInput L548 placeholder
  visibility ReviewVisibility @default(VISIBLE)


  // track last report reason inline.. show 1 report per review
  reportReason        String?       // From ReportedReviewReason: "Inappropriate language", etc.
  reportedById        String?       // User who reported it (host or another guest)
  reportedBy          User?         @relation("ReviewReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  reportStatus        ReportedReviewStatus?       // "pending" | "closed" — mapped by admin reported-reviews page
  moderatedAt         DateTime?
  moderatedNote       String?       // Admin audit note: "Retained — user was quoting license plate, not hate speech"

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt


  @@index([listingId, createdAt(sort: Desc)])
  @@index([hostId, createdAt(sort: Desc)])
  @@index([reportStatus, createdAt(sort: Desc)])
}

enum ReportedReviewStatus {
  CLOSED
  PENDING
}

enum ReviewVisibility {
  VISIBLE
  REMOVED
  HIDDEN_BY_HOST // Host voluntarily hid (optional future feature).
  FLAGGED
}

enum BankAccountStatus {
  PENDING      // Host entered details, not yet verified by finance / payment provider
  VERIFIED     // Bank details confirmed — payouts can be sent
  FAILED       // Verification failed (wrong account number, name mismatch, etc.)
}


model BankAccount {
  id             String             @id @default(cuid())
  userId         String             @unique   // 1 BankAccount per user for now — remove @unique later to allow multiple accounts (business/personal)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  bankName       String             // e.g. "Access Bank"
  accountNumber  String             // e.g. "0123456789"
  accountName    String             // Full name on the account (must match user's legal name)

  // ↓ Coming soon (Nigeria mandatory for payouts):
  bvn            String?            // Bank Verification Number (CBN requires this for all NG payouts)
  bankCode       String?            // Flutterwave/Paystack bank code (e.g. "044" = Access Bank) — eliminates typos in bank name
  status         BankAccountStatus  @default(PENDING)
  verifiedAt     DateTime?          // When finance / payment provider confirmed it worked
  providerRef    String?            // flwRecipientId or paystackRecipientCode — cache so we don't re-verify every payout

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([userId])
}
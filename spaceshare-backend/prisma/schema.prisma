generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  password         String?
  role             Role              @default(GUEST)
  isVerified       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  avatarUrl        String?
  firstName        String?
  lastName         String?
  phone            String?
  isFirstLogin        Boolean           @default(true)
  authProvider        AuthProvider      @default(LOCAL)
  googleId            String?           @unique
  appleId             String?           @unique
  emailNotifications  Boolean           @default(true)
  smsNotifications    Boolean           @default(true)
  pushNotifications   Boolean           @default(true)
  pushToken           String?
  verificationCode    VerificationCode?
  listings         Listing[]
  bookings         Booking[]
  notifications    Notification[]

  status           UserStatus           @default(PENDING)
  invitedAt        DateTime?
  invitedBy        String?
  invitedByUser    User?      @relation("InvitedBy", fields: [invitedBy], references: [id])
  lastLoginAt      DateTime?
  invited          User[]     @relation("InvitedBy")
  passwordHistories  PasswordHistory[]
}

model VerificationCode {
  id        String   @id @default(cuid())
  code      String
  expiresAt DateTime
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum Role {
  GUEST
  HOST
  ADMIN
  SUPER_ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  APPROVED
  DECLINED
  PAID
  COMPLETED
  CANCELLED
}

enum NotificationType {
  BOOKING_REQUEST_SENT
  BOOKING_APPROVED
  BOOKING_DECLINED
  BOOKING_CANCELLED
  PAYMENT_SUCCESSFUL
  PAYMENT_FAILED
  REVIEW_REMINDER
  DISPUTE_SUBMITTED
  REFUND_PROCESSED
  NEW_BOOKING_REQUEST
  LISTING_APPROVED
  LISTING_REJECTED
  REVIEW_RECEIVED
  PAYOUT_SENT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  bookingId String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model Listing {
  id                String        @id @default(cuid())
  hostId            String
  host              User          @relation(fields: [hostId], references: [id], onDelete: Cascade)

  spaceName         String
  spaceCategory     String
  addressLine       String
  area              String
  description       String

  photos            String[]
  amenities         String[]

  spaceCapacity     Int
  spacePrice        Int

  addOns            Json?

  hostRules         String
  parkingInstruction String?

  startTime         String
  endTime           String
  unavailableDates  String[]

  status            ListingStatus @default(PENDING)
  rejectionReason   String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  bookings          Booking[]
}

model Booking {
  id              String        @id @default(cuid())
  listingId       String
  listing         Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  guestId         String
  guest           User          @relation(fields: [guestId], references: [id], onDelete: Cascade)

  spaceName       String
  spaceLocation   String
  spacePrice      Int

  startDate       String
  endDate         String
  startTime       String
  endTime         String
  guests          Int

  addOnsBreakdown Json?
  cautionFee      Int           @default(0)
  serviceFee      Int           @default(0)
  totalPrice      Int

  status          BookingStatus @default(PENDING)
  declineReason   String?
  cancelReason    String?
  paymentRef      String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model PasswordHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash      String
  usedAt    DateTime @default(now())

  @@index([userId])
}


model AuditLog{
  id        String        @id @default(cuid()) 
}